+package com.webtoapp.core.apkbuilder
+
+import com.webtoapp.data.model.ApkExportConfig
+import com.webtoapp.data.model.ApkRuntimePermissions
+import com.webtoapp.data.model.NativeBridgeCapabilities
+import com.webtoapp.data.model.ScriptRunTime
+import com.webtoapp.data.model.UserScript
+import com.webtoapp.data.model.WebViewConfig
+import com.webtoapp.data.model.withRuntimePermissionsSyncedFromFeatures
+
+enum class NativeFeature(
+    val title: String,
+    val description: String,
+    val packagedOnly: Boolean = false,
+) {
+    NOTIFICATIONS(
+        "Notifications",
+        "Show Android alerts and app notifications."
+    ),
+    REMINDERS(
+        "Scheduled reminders",
+        "Schedule Android reminders that can fire after the app leaves the screen.",
+        packagedOnly = true,
+    ),
+    BACKGROUND(
+        "Background operation",
+        "Enable the Android foreground/background support used by long-running app features."
+    ),
+    LOCATION(
+        "Location / GPS",
+        "Allow the web app to request the device location when the user approves."
+    ),
+    CAMERA(
+        "Camera",
+        "Allow camera access for supported web inputs and capture features."
+    ),
+    MICROPHONE(
+        "Microphone",
+        "Allow microphone access for supported web audio features."
+    ),
+    BLUETOOTH(
+        "Bluetooth",
+        "Include Android Bluetooth runtime permission support for compatible app features."
+    ),
+    FILES(
+        "Files / storage",
+        "Enable native file-save/download support from packaged HTML."
+    ),
+    VIBRATION(
+        "Vibration / haptics",
+        "Allow packaged HTML to trigger Android vibration feedback.",
+        packagedOnly = true,
+    ),
+}
+
+data class NativeFeatureConfig(
+    val webViewConfig: WebViewConfig,
+    val apkExportConfig: ApkExportConfig,
+)
+
+object NativeFeaturePreset {
+    private const val BRIDGE_ALIAS_SCRIPT =
+        "(function(){if(window.NativeBridge&&!window.APKBuilderNative){window.APKBuilderNative=window.NativeBridge;}})();"
+
+    fun build(
+        features: Set<NativeFeature>,
+        packagedSource: Boolean,
+    ): NativeFeatureConfig {
+        val notifications = NativeFeature.NOTIFICATIONS in features ||
+            NativeFeature.REMINDERS in features ||
+            NativeFeature.BACKGROUND in features
+        val bridgeRequested = packagedSource && features.any {
+            it in setOf(
+                NativeFeature.NOTIFICATIONS,
+                NativeFeature.REMINDERS,
+                NativeFeature.BACKGROUND,
+                NativeFeature.FILES,
+                NativeFeature.VIBRATION,
+            )
+        }
+
+        val bridgeCapabilities = NativeBridgeCapabilities(
+            clipboard = false,
+            vibration = NativeFeature.VIBRATION in features,
+            geolocation = false,
+            brightness = false,
+            notification = notifications,
+            notificationScheduled = NativeFeature.REMINDERS in features,
+            notificationPersistent = NativeFeature.BACKGROUND in features,
+            download = NativeFeature.FILES in features,
+            privateNetwork = false,
+            screenWake = false,
+            openExternal = false,
+            deviceInfo = false,
+            securityInfo = false,
+            networkInfo = NativeFeature.BACKGROUND in features,
+            toast = false,
+            logging = false,
+            findInPage = false,
+            orientation = false,
+            fullscreen = false,
+            print = false,
+        )
+
+        val webView = WebViewConfig(
+            enableNativeBridge = bridgeRequested,
+            nativeBridgeCapabilities = bridgeCapabilities,
+            enableNotificationPolyfill = notifications,
+            geolocationEnabled = NativeFeature.LOCATION in features,
+            downloadEnabled = NativeFeature.FILES in features,
+            injectScripts = if (bridgeRequested) {
+                listOf(UserScript(
+                    name = "APK Builder Native Bridge",
+                    code = BRIDGE_ALIAS_SCRIPT,
+                    enabled = true,
+                    runAt = ScriptRunTime.DOCUMENT_END,
+                ))
+            } else emptyList(),
+        )
+
+        val initialPermissions = ApkRuntimePermissions(
+            camera = NativeFeature.CAMERA in features,
+            microphone = NativeFeature.MICROPHONE in features,
+            location = NativeFeature.LOCATION in features,
+            bluetooth = NativeFeature.BLUETOOTH in features,
+            vibration = NativeFeature.VIBRATION in features,
+        )
+        val export = ApkExportConfig(
+            runtimePermissions = initialPermissions,
+            notificationEnabled = notifications,
+            backgroundRunEnabled = NativeFeature.BACKGROUND in features,
+        ).withRuntimePermissionsSyncedFromFeatures(webViewConfig = webView)
+
+        return NativeFeatureConfig(webViewConfig = webView, apkExportConfig = export)
+    }
+}
