+@Composable
+private fun NativeFeaturesStep(
+    selected: Set<NativeFeature>,
+    websiteSource: Boolean,
+    onToggle: (NativeFeature) -> Unit,
+) {
+    Text("Native features", style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
+    Text(
+        "Choose only what this app needs. Android will still ask the user before granting protected permissions.",
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+    )
+    if (websiteSource) {
+        Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.secondaryContainer)) {
+            Text(
+                "Website wrappers keep the privileged native bridge off for security. Features marked packaged-only are available for HTML/ZIP apps.",
+                modifier = Modifier.padding(14.dp),
+                color = MaterialTheme.colorScheme.onSecondaryContainer,
+            )
+        }
+    }
+    NativeFeature.entries.forEach { feature ->
+        val enabled = !websiteSource || !feature.packagedOnly
+        Card(
+            modifier = Modifier.fillMaxWidth().then(
+                if (enabled) Modifier.clickable { onToggle(feature) } else Modifier
+            ),
+            colors = CardDefaults.cardColors(
+                containerColor = if (feature in selected) MaterialTheme.colorScheme.primaryContainer
+                else MaterialTheme.colorScheme.surfaceContainerHigh
+            ),
+        ) {
+            Row(
+                modifier = Modifier.fillMaxWidth().padding(16.dp),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Checkbox(
+                    checked = feature in selected,
+                    onCheckedChange = if (enabled) ({ onToggle(feature) }) else null,
+                    enabled = enabled,
+                )
+                Column(Modifier.padding(start = 10.dp).weight(1f)) {
+                    Text(feature.title, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                    Text(feature.description, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    if (!enabled) Text("HTML/ZIP only", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.primary)
+                }
+            }
+        }
+    }
+}
