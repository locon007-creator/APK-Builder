+    }
+    Button(onClick = onGenerate, enabled = !isBusy, modifier = Modifier.fillMaxWidth()) {
+        Icon(Icons.Outlined.AutoAwesome, null); Spacer(Modifier.size(8.dp)); Text(ApkBuilderStrings.generateSplash)
+    }
+}
+
+@Composable
+private fun ConfirmationStep(
+    source: WizardSource?, websiteUrl: String, htmlFile: HtmlFile?, zipAnalysis: ZipProjectImporter.ZipProjectAnalysis?, appName: String, iconPath: String?, splashPath: String?,
+) {
+    Text(ApkBuilderStrings.confirmTitle, style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
+    SummaryCard(ApkBuilderStrings.appName, appName)
+    SummaryCard(ApkBuilderStrings.sourceLabel, when (source) {
+        WizardSource.WEBSITE -> websiteUrl
+        WizardSource.HTML_FILE -> htmlFile?.name.orEmpty()
+        WizardSource.ZIP_PROJECT -> zipAnalysis?.zipFileName.orEmpty()
+        null -> ""
+    })
+    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        Column(Modifier.weight(1f)) { ArtworkPreview(iconPath, true); Text(ApkBuilderStrings.iconReady, modifier = Modifier.fillMaxWidth(), textAlign = TextAlign.Center) }
+        Column(Modifier.weight(1f)) { ArtworkPreview(splashPath, false, true); Text(ApkBuilderStrings.splashReady, modifier = Modifier.fillMaxWidth(), textAlign = TextAlign.Center) }
+    }
+}
