+@Composable
+private fun SourceStep(
+    source: WizardSource?, websiteUrl: String, htmlFile: HtmlFile?, zipAnalysis: ZipProjectImporter.ZipProjectAnalysis?, isBusy: Boolean,
+    onSource: (WizardSource) -> Unit, onWebsiteUrl: (String) -> Unit, onHtml: () -> Unit, onZip: () -> Unit,
+) {
+    Text(ApkBuilderStrings.sourceTitle, style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
+    Text(ApkBuilderStrings.intro, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    SourceCard(Icons.Outlined.Code, ApkBuilderStrings.htmlFile, ApkBuilderStrings.htmlHint, source == WizardSource.HTML_FILE) { onSource(WizardSource.HTML_FILE) }
+    if (source == WizardSource.HTML_FILE) SourceAction(htmlFile?.name, ApkBuilderStrings.selectFile, !isBusy, onHtml)
+    SourceCard(Icons.Outlined.FolderZip, ApkBuilderStrings.zipProject, ApkBuilderStrings.zipHint, source == WizardSource.ZIP_PROJECT) { onSource(WizardSource.ZIP_PROJECT) }
+    if (source == WizardSource.ZIP_PROJECT) SourceAction(zipAnalysis?.zipFileName, ApkBuilderStrings.selectZip, !isBusy, onZip)
+    SourceCard(Icons.Outlined.Language, ApkBuilderStrings.website, ApkBuilderStrings.websiteHint, source == WizardSource.WEBSITE) { onSource(WizardSource.WEBSITE) }
+    if (source == WizardSource.WEBSITE) {
+        OutlinedTextField(value = websiteUrl, onValueChange = onWebsiteUrl, label = { Text(ApkBuilderStrings.urlLabel) }, placeholder = { Text("https://example.com") }, singleLine = true, modifier = Modifier.fillMaxWidth())
+    }
+}
+
+@Composable
+private fun IdentityStep(appName: String, iconPath: String?, isBusy: Boolean, onName: (String) -> Unit, onUpload: () -> Unit, onGenerate: () -> Unit) {
+    Text(ApkBuilderStrings.identityTitle, style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
+    OutlinedTextField(value = appName, onValueChange = onName, label = { Text(ApkBuilderStrings.appName) }, singleLine = true, modifier = Modifier.fillMaxWidth())
+    ArtworkPreview(iconPath, square = true)
+    Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+        OutlinedButton(onClick = onUpload, enabled = !isBusy, modifier = Modifier.weight(1f), contentPadding = PaddingValues(12.dp)) {
+            Icon(Icons.Outlined.UploadFile, null); Spacer(Modifier.size(6.dp)); Text(ApkBuilderStrings.uploadIcon)
+        }
+        Button(onClick = onGenerate, enabled = !isBusy && appName.isNotBlank(), modifier = Modifier.weight(1f), contentPadding = PaddingValues(12.dp)) {
+            Icon(Icons.Outlined.AutoAwesome, null); Spacer(Modifier.size(6.dp)); Text(ApkBuilderStrings.generateIcon)
+        }
+    }
+}
+
+@Composable
+private fun SplashStep(splashPath: String?, isBusy: Boolean, onUpload: () -> Unit, onGenerate: () -> Unit) {
+    Text(ApkBuilderStrings.splashTitle, style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
+    Text(ApkBuilderStrings.splashHint, color = MaterialTheme.colorScheme.onSurfaceVariant)
