+/** Deterministic, free on-device icon and splash generation. */
+object LocalArtwork {
+    val palettes = listOf(
+        0xFF5B4BDBL to 0xFF2D1F8FL,
+        0xFF006B5FL to 0xFF003D36L,
+        0xFFB54708L to 0xFF6B2600L,
+        0xFF9B2C63L to 0xFF561234L,
+        0xFF146C94L to 0xFF083A52L,
+    )
+
+    fun initials(appName: String): String {
+        val words = appName.trim().split(Regex("\\s+")).filter(String::isNotBlank)
+        if (words.isEmpty()) return "AP"
+        return if (words.size == 1) words.first().take(1).uppercase()
+        else "${words.first().first()}${words.last().first()}".uppercase()
+    }
+
+    fun paletteIndex(appName: String): Int =
+        (appName.hashCode().toLong().absoluteValue % palettes.size).toInt()
+
+    fun generateIcon(context: Context, appName: String): String? = try {
+        val (start, end) = palettes[paletteIndex(appName)]
+        val bitmap = Bitmap.createBitmap(512, 512, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        val background = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            shader = LinearGradient(0f, 0f, 512f, 512f, start.toInt(), end.toInt(), Shader.TileMode.CLAMP)
+        }
+        canvas.drawRoundRect(RectF(0f, 0f, 512f, 512f), 112f, 112f, background)
+        val halo = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.argb(42, 255, 255, 255) }
+        canvas.drawCircle(256f, 238f, 158f, halo)
+        val text = initials(appName)
+        val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.WHITE
+            textAlign = Paint.Align.CENTER
+            textSize = if (text.length == 1) 226f else 176f
+            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+        }
+        val baseline = 256f - (textPaint.descent() + textPaint.ascent()) / 2f
+        canvas.drawText(text, 256f, baseline, textPaint)
+        IconStorage.saveIconFromBitmap(context, bitmap).also { bitmap.recycle() }
+    } catch (_: Exception) {
+        null
+    }
+
+    fun generateSplash(context: Context, appName: String, iconPath: String): String? {
+        return try {
+            val icon = BitmapFactory.decodeFile(iconPath) ?: return null
+            val (start, end) = palettes[paletteIndex(appName)]
+            val bitmap = Bitmap.createBitmap(1080, 1920, Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            val background = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                shader = LinearGradient(0f, 0f, 1080f, 1920f, end.toInt(), Color.rgb(8, 9, 14), Shader.TileMode.CLAMP)
+            }
+            canvas.drawRect(0f, 0f, 1080f, 1920f, background)
+            val glow = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = Color.argb(50, Color.red(start.toInt()), Color.green(start.toInt()), Color.blue(start.toInt()))
+            }
+            canvas.drawCircle(540f, 820f, 330f, glow)
+            canvas.drawBitmap(icon, null, Rect(360, 640, 720, 1000), Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG))
+            val titlePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = Color.WHITE
+                textAlign = Paint.Align.CENTER
+                textSize = 68f
+                typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+            }
+            canvas.drawText(appName, 540f, 1125f, titlePaint)
+            val directory = File(context.filesDir, "splash_media").apply { mkdirs() }
+            val file = File(directory, "splash_${UUID.randomUUID()}.png")
+            FileOutputStream(file).use { bitmap.compress(Bitmap.CompressFormat.PNG, 92, it) }
+            icon.recycle()
+            bitmap.recycle()
+            file.absolutePath
+        } catch (_: Exception) {
+            null
+        }
+    }
+}
