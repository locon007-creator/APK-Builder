+enum class WizardSource { WEBSITE, HTML_FILE, ZIP_PROJECT }
+
+enum class WizardStep { SOURCE, IDENTITY, SPLASH, CONFIRM, CREATING }
+
+object WizardRules {
+    fun isValidWebsite(value: String): Boolean = try {
+        val uri = URI(value.trim())
+        uri.scheme in setOf("http", "https") && !uri.host.isNullOrBlank()
+    } catch (_: Exception) {
+        false
+    }
+
+    fun canContinue(
+        step: WizardStep,
+        sourceReady: Boolean,
+        appName: String,
+        hasIcon: Boolean,
+        hasSplash: Boolean,
+    ): Boolean = when (step) {
+        WizardStep.SOURCE -> sourceReady
+        WizardStep.IDENTITY -> appName.isNotBlank() && hasIcon
+        WizardStep.SPLASH -> hasIcon && hasSplash
+        WizardStep.CONFIRM -> sourceReady && appName.isNotBlank() && hasIcon && hasSplash
+        WizardStep.CREATING -> false
+    }
+
+    fun next(step: WizardStep): WizardStep = when (step) {
+        WizardStep.SOURCE -> WizardStep.IDENTITY
+        WizardStep.IDENTITY -> WizardStep.SPLASH
+        WizardStep.SPLASH -> WizardStep.CONFIRM
+        WizardStep.CONFIRM, WizardStep.CREATING -> WizardStep.CREATING
+    }
+
+    fun previous(step: WizardStep): WizardStep = when (step) {
+        WizardStep.SOURCE, WizardStep.IDENTITY -> WizardStep.SOURCE
+        WizardStep.SPLASH -> WizardStep.IDENTITY
+        WizardStep.CONFIRM, WizardStep.CREATING -> WizardStep.SPLASH
+    }
+}
