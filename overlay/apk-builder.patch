+package com.webtoapp.ui.wizard
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ApkBuilderWizardRulesTest {
+    @Test
+    fun `wizard exposes website html and zip sources`() {
+        assertEquals(
+            listOf(WizardSource.WEBSITE, WizardSource.HTML_FILE, WizardSource.ZIP_PROJECT),
+            WizardSource.entries
+        )
+    }
+
+    @Test
+    fun `icon initials are stable and never exceed two characters`() {
+        assertEquals("AB", LocalArtwork.initials("APK Builder"))
+        assertEquals("S", LocalArtwork.initials("shop"))
+        assertEquals("AP", LocalArtwork.initials("  amazing   project "))
+        assertEquals("AP", LocalArtwork.initials(""))
+    }
+
+    @Test
+    fun `each app name deterministically selects an artwork palette`() {
+        assertEquals(LocalArtwork.paletteIndex("APK Builder"), LocalArtwork.paletteIndex("APK Builder"))
+        assertTrue(LocalArtwork.paletteIndex("APK Builder") in LocalArtwork.palettes.indices)
+        assertFalse(LocalArtwork.palettes.isEmpty())
+    }
+
+    @Test
+    fun `website source accepts only usable web addresses`() {
+        assertTrue(WizardRules.isValidWebsite("https://example.com/app"))
+        assertTrue(WizardRules.isValidWebsite("http://192.168.1.5"))
+        assertFalse(WizardRules.isValidWebsite("example.com"))
+        assertFalse(WizardRules.isValidWebsite("file:///storage/index.html"))
+        assertFalse(WizardRules.isValidWebsite("https://"))
+    }
+
+    @Test
+    fun `wizard requires source name icon and splash in order`() {
+        assertFalse(WizardRules.canContinue(WizardStep.SOURCE, sourceReady = false, appName = "", hasIcon = false, hasSplash = false))
+        assertTrue(WizardRules.canContinue(WizardStep.SOURCE, sourceReady = true, appName = "", hasIcon = false, hasSplash = false))
+        assertFalse(WizardRules.canContinue(WizardStep.IDENTITY, sourceReady = true, appName = "My App", hasIcon = false, hasSplash = false))
+        assertTrue(WizardRules.canContinue(WizardStep.IDENTITY, sourceReady = true, appName = "My App", hasIcon = true, hasSplash = false))
+        assertFalse(WizardRules.canContinue(WizardStep.SPLASH, sourceReady = true, appName = "My App", hasIcon = true, hasSplash = false))
+        assertTrue(WizardRules.canContinue(WizardStep.SPLASH, sourceReady = true, appName = "My App", hasIcon = true, hasSplash = true))
+        assertTrue(WizardRules.canContinue(WizardStep.CONFIRM, sourceReady = true, appName = "My App", hasIcon = true, hasSplash = true))
+    }
+
+    @Test
+    fun `wizard progresses through confirmation before creating`() {
+        assertEquals(WizardStep.IDENTITY, WizardRules.next(WizardStep.SOURCE))
+        assertEquals(WizardStep.SPLASH, WizardRules.next(WizardStep.IDENTITY))
+        assertEquals(WizardStep.CONFIRM, WizardRules.next(WizardStep.SPLASH))
+        assertEquals(WizardStep.CREATING, WizardRules.next(WizardStep.CONFIRM))
+        assertEquals(WizardStep.CREATING, WizardRules.next(WizardStep.CREATING))
+    }
+}
