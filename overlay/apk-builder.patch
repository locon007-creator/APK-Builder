+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ApkBuilderWizardScreen(
+    viewModel: MainViewModel,
+    onProjects: () -> Unit,
+    onBuild: (Long) -> Unit,
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val uiState by viewModel.uiState.collectAsStateWithLifecycle()
+
+    var step by remember { mutableStateOf(WizardStep.SOURCE) }
+    var source by remember { mutableStateOf<WizardSource?>(null) }
+    var websiteUrl by remember { mutableStateOf("") }
+    var htmlFile by remember { mutableStateOf<HtmlFile?>(null) }
+    var zipAnalysis by remember { mutableStateOf<ZipProjectImporter.ZipProjectAnalysis?>(null) }
+    var appName by remember { mutableStateOf("") }
+    var iconPath by remember { mutableStateOf<String?>(null) }
+    var splashPath by remember { mutableStateOf<String?>(null) }
+    var errorMessage by remember { mutableStateOf<String?>(null) }
+    var isBusy by remember { mutableStateOf(false) }
+
+    val htmlPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) scope.launch {
+            isBusy = true
+            val selected = withContext(Dispatchers.IO) { copyHtmlToCache(context, uri) }
+            isBusy = false
+            if (selected == null) errorMessage = ApkBuilderStrings.missingHtml
+            else {
+                htmlFile = selected
+                zipAnalysis = null
+                source = WizardSource.HTML_FILE
+                if (appName.isBlank()) appName = selected.name.substringBeforeLast('.')
+                errorMessage = null
+            }
+        }
+    }
+
+    val zipPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) scope.launch {
+            isBusy = true
+            try {
+                val selected = withContext(Dispatchers.IO) { ZipProjectImporter.importZip(context, uri) }
+                if (selected.htmlFiles.isEmpty()) errorMessage = ApkBuilderStrings.missingZipHtml
+                else {
+                    zipAnalysis = selected
+                    htmlFile = null
+                    source = WizardSource.ZIP_PROJECT
+                    if (appName.isBlank()) appName = selected.suggestedAppName
+                    errorMessage = null
+                }
+            } catch (_: Exception) {
+                errorMessage = ApkBuilderStrings.missingZipHtml
+            } finally {
+                isBusy = false
+            }
+        }
+    }
+
+    val iconPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) scope.launch {
+            isBusy = true
+            val selected = withContext(Dispatchers.IO) { IconStorage.saveIconFromUri(context, uri) }
+            isBusy = false
+            if (selected == null) errorMessage = ApkBuilderStrings.artworkFailed
+            else {
+                iconPath = selected
+                splashPath = null
+                errorMessage = null
+            }
+        }
+    }
+
+    val splashPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) scope.launch {
+            isBusy = true
+            val selected = withContext(Dispatchers.IO) { SplashStorage.saveMediaFromUri(context, uri, false) }
+            isBusy = false
+            if (selected == null) errorMessage = ApkBuilderStrings.artworkFailed
+            else {
+                splashPath = selected
+                errorMessage = null
+            }
+        }
+    }
+
+    val sourceReady = when (source) {
+        WizardSource.WEBSITE -> WizardRules.isValidWebsite(websiteUrl)
+        WizardSource.HTML_FILE -> htmlFile?.let { File(it.path).canRead() && File(it.path).length() > 0L } == true
+        WizardSource.ZIP_PROJECT -> zipAnalysis?.htmlFiles?.isNotEmpty() == true
+        null -> false
+    }
+
+    LaunchedEffect(uiState) {
+        if (uiState is UiState.Error) {
+            isBusy = false
+            step = WizardStep.CONFIRM
+            errorMessage = (uiState as UiState.Error).message.ifBlank { ApkBuilderStrings.createFailed }
+        }
+    }
+
+    fun goBack() {
+        if (step == WizardStep.SOURCE) onProjects()
+        else if (step != WizardStep.CREATING) step = WizardRules.previous(step)
+    }
+
+    fun createAndBuild() {
+        if (!WizardRules.canContinue(step, sourceReady, appName, iconPath != null, splashPath != null)) return
+        val finalIcon = iconPath ?: return
+        val finalSplash = splashPath ?: return
+        val completed: (Long) -> Unit = { id ->
+            isBusy = false
+            if (id > 0) onBuild(id) else {
+                step = WizardStep.CONFIRM
+                errorMessage = ApkBuilderStrings.createFailed
+            }
+        }
+        step = WizardStep.CREATING
+        isBusy = true
+        errorMessage = null
+        when (source) {
+            WizardSource.WEBSITE -> {
+                viewModel.createNewApp()
+                viewModel.updateEditState {
+                    copy(
+                        name = appName.trim(),
+                        url = websiteUrl.trim(),
+                        appType = AppType.WEB,
+                        iconUri = null,
+                        savedIconPath = finalIcon,
+                        splashEnabled = true,
+                        splashMediaUri = Uri.fromFile(File(finalSplash)),
+                        savedSplashPath = finalSplash,
+                        splashConfig = SplashConfig(mediaPath = finalSplash),
+                    )
+                }
+                viewModel.saveApp(onSaved = completed)
+            }
+            WizardSource.HTML_FILE -> {
+                val selected = htmlFile ?: return
+                viewModel.saveHtmlApp(
+                    name = appName.trim(),
+                    htmlConfig = HtmlConfig(entryFile = selected.name, files = listOf(selected)),
+                    iconUri = null,
+                    iconPath = finalIcon,
+                    splashPath = finalSplash,
+                    onCreated = completed,
+                )
+            }
+            WizardSource.ZIP_PROJECT -> {
+                val selected = zipAnalysis ?: return
+                viewModel.saveZipHtmlApp(
+                    name = appName.trim(),
+                    extractedDir = selected.extractDir,
+                    entryFile = selected.entryFile,
+                    iconUri = null,
+                    iconPath = finalIcon,
+                    splashPath = finalSplash,
+                    onCreated = completed,
+                )
+            }
+            null -> {
+                isBusy = false
+                step = WizardStep.SOURCE
+            }
+        }
+    }
+
+    Scaffold(
+        topBar = {
+            Column {
+                TopAppBar(
+                    title = { Text(ApkBuilderStrings.title, fontWeight = FontWeight.Bold) },
+                    navigationIcon = {
+                        IconButton(onClick = ::goBack, enabled = step != WizardStep.CREATING) {
+                            Icon(Icons.AutoMirrored.Outlined.ArrowBack, contentDescription = null)
+                        }
+                    },
+                    colors = TopAppBarDefaults.topAppBarColors(containerColor = MaterialTheme.colorScheme.surface),
+                )
+                if (step != WizardStep.CREATING) {
+                    LinearProgressIndicator(progress = { (step.ordinal + 1).coerceAtMost(4) / 4f }, modifier = Modifier.fillMaxWidth())
+                }
+            }
+        },
+        bottomBar = {
+            if (step != WizardStep.CREATING) {
+                Surface(shadowElevation = 8.dp) {
+                    Column(
+                        modifier = Modifier.fillMaxWidth().navigationBarsPadding().padding(16.dp),
+                        verticalArrangement = Arrangement.spacedBy(10.dp),
+                    ) {
+                        Button(
+                            onClick = {
+                                when (step) {
+                                    WizardStep.SOURCE -> {
+                                        if (source == WizardSource.WEBSITE && !WizardRules.isValidWebsite(websiteUrl)) errorMessage = ApkBuilderStrings.invalidWebsite
+                                        else { errorMessage = null; step = WizardRules.next(step) }
+                                    }
+                                    WizardStep.IDENTITY, WizardStep.SPLASH -> { errorMessage = null; step = WizardRules.next(step) }
+                                    WizardStep.CONFIRM -> createAndBuild()
+                                    WizardStep.CREATING -> Unit
+                                }
+                            },
+                            enabled = !isBusy && WizardRules.canContinue(step, sourceReady, appName, iconPath != null, splashPath != null),
+                            modifier = Modifier.fillMaxWidth().height(54.dp),
+                        ) { Text(if (step == WizardStep.CONFIRM) ApkBuilderStrings.confirmBuild else ApkBuilderStrings.continueLabel) }
+                        if (step == WizardStep.SOURCE) {
+                            OutlinedButton(onClick = onProjects, modifier = Modifier.fillMaxWidth()) { Text(ApkBuilderStrings.projects) }
+                        }
+                    }
+                }
+            }
+        },
+    ) { padding ->
+        Column(
+            modifier = Modifier.fillMaxSize().padding(padding).verticalScroll(rememberScrollState()).padding(20.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp),
+        ) {
+            errorMessage?.let { ErrorCard(it) }
+            when (step) {
+                WizardStep.SOURCE -> SourceStep(
+                    source, websiteUrl, htmlFile, zipAnalysis, isBusy,
+                    onSource = { source = it; errorMessage = null },
+                    onWebsiteUrl = { websiteUrl = it; source = WizardSource.WEBSITE },
+                    onHtml = { htmlPicker.launch(arrayOf("text/html", "application/xhtml+xml", "text/plain")) },
+                    onZip = { zipPicker.launch(arrayOf("application/zip", "application/x-zip-compressed", "application/octet-stream")) },
+                )
+                WizardStep.IDENTITY -> IdentityStep(
+                    appName, iconPath, isBusy,
+                    onName = { appName = it },
+                    onUpload = { iconPicker.launch(arrayOf("image/*")) },
+                    onGenerate = {
+                        scope.launch {
+                            isBusy = true
+                            val generated = withContext(Dispatchers.IO) { LocalArtwork.generateIcon(context, appName) }
+                            isBusy = false
+                            if (generated == null) errorMessage = ApkBuilderStrings.artworkFailed
+                            else { iconPath = generated; splashPath = null; errorMessage = null }
+                        }
+                    },
+                )
+                WizardStep.SPLASH -> SplashStep(
+                    splashPath, isBusy,
+                    onUpload = { splashPicker.launch(arrayOf("image/*")) },
+                    onGenerate = generate@{
+                        val selectedIcon = iconPath ?: return@generate
+                        scope.launch {
+                            isBusy = true
+                            val generated = withContext(Dispatchers.IO) { LocalArtwork.generateSplash(context, appName, selectedIcon) }
+                            isBusy = false
+                            if (generated == null) errorMessage = ApkBuilderStrings.artworkFailed
+                            else { splashPath = generated; errorMessage = null }
+                        }
+                    },
+                )
+                WizardStep.CONFIRM -> ConfirmationStep(source, websiteUrl, htmlFile, zipAnalysis, appName, iconPath, splashPath)
+                WizardStep.CREATING -> CreatingStep()
+            }
+            Spacer(Modifier.height(12.dp))
+        }
+    }
+}
