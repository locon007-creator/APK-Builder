@@ -0,0 +1,83 @@
+package com.webtoapp.core.apkbuilder
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class NativeFeaturePresetTest {
+    @Test
+    fun `notifications and reminders enable native notification bridge for packaged apps`() {
+        val result = NativeFeaturePreset.build(
+            features = setOf(NativeFeature.NOTIFICATIONS, NativeFeature.REMINDERS),
+            packagedSource = true,
+        )
+
+        assertTrue(result.webViewConfig.enableNativeBridge)
+        assertTrue(result.webViewConfig.nativeBridgeCapabilities.notification)
+        assertTrue(result.webViewConfig.nativeBridgeCapabilities.notificationScheduled)
+        assertTrue(result.apkExportConfig.notificationEnabled)
+        assertTrue(result.apkExportConfig.runtimePermissions.notifications)
+    }
+
+    @Test
+    fun `background feature enables converter background runtime requirements`() {
+        val result = NativeFeaturePreset.build(
+            features = setOf(NativeFeature.BACKGROUND),
+            packagedSource = true,
+        )
+
+        assertTrue(result.apkExportConfig.backgroundRunEnabled)
+        assertTrue(result.apkExportConfig.runtimePermissions.foregroundService)
+        assertTrue(result.apkExportConfig.runtimePermissions.wakeLock)
+        assertTrue(result.webViewConfig.nativeBridgeCapabilities.notificationPersistent)
+    }
+
+    @Test
+    fun `device features map to runtime permissions`() {
+        val result = NativeFeaturePreset.build(
+            features = setOf(
+                NativeFeature.LOCATION,
+                NativeFeature.CAMERA,
+                NativeFeature.MICROPHONE,
+                NativeFeature.BLUETOOTH,
+                NativeFeature.VIBRATION,
+            ),
+            packagedSource = true,
+        )
+
+        assertTrue(result.webViewConfig.geolocationEnabled)
+        assertTrue(result.apkExportConfig.runtimePermissions.location)
+        assertTrue(result.apkExportConfig.runtimePermissions.camera)
+        assertTrue(result.apkExportConfig.runtimePermissions.microphone)
+        assertTrue(result.apkExportConfig.runtimePermissions.bluetooth)
+        assertTrue(result.apkExportConfig.runtimePermissions.vibration)
+    }
+
+    @Test
+    fun `packaged bridge exposes APK Builder alias script`() {
+        val result = NativeFeaturePreset.build(
+            features = setOf(NativeFeature.VIBRATION),
+            packagedSource = true,
+        )
+
+        assertTrue(result.webViewConfig.enableNativeBridge)
+        assertTrue(result.webViewConfig.injectScripts.any { it.code.contains("APKBuilderNative") })
+    }
+
+    @Test
+    fun `remote website never receives privileged native bridge`() {
+        val result = NativeFeaturePreset.build(
+            features = setOf(
+                NativeFeature.NOTIFICATIONS,
+                NativeFeature.REMINDERS,
+                NativeFeature.BACKGROUND,
+                NativeFeature.VIBRATION,
+            ),
+            packagedSource = false,
+        )
+
+        assertFalse(result.webViewConfig.enableNativeBridge)
+        assertFalse(result.webViewConfig.injectScripts.any { it.code.contains("APKBuilderNative") })
+        assertTrue(result.webViewConfig.enableNotificationPolyfill)
+    }
+}
