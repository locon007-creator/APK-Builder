# ---- Server ----
PORT=8787
# demo = fictional, clearly labeled dataset (data/demo.db)
# sec  = official SEC EDGAR data ingested with `npm run ingest` (data/quarry.db)
QUARRY_DATASET=demo
# Optional explicit DB path (overrides dataset default)
# QUARRY_DB_PATH=./data/quarry.db

# ---- SEC EDGAR (required for `npm run ingest`) ----
# SEC fair-access policy requires a descriptive User-Agent with contact info.
SEC_USER_AGENT="YourCompany Research contact@example.com"
# Requests per second (SEC limit is 10; stay below it)
SEC_MAX_RPS=8
# Path to the tracked universe of managers / issuers / CUSIP mappings
QUARRY_UNIVERSE=./config/universe.json

# ---- Market data (optional) ----
# none | polygon | alphavantage
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=
# Declared delay of your plan in minutes (0 = real-time entitlement)
MARKET_DATA_DELAY_MINUTES=15

# ---- External alert delivery (optional; in-app alerts always work) ----
# Webhook that receives JSON alert payloads (e.g. your email/push relay)
ALERT_WEBHOOK_URL=
